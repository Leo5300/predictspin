# Copie para .env e preencha. O .env nunca vai para o repositório.
# Variáveis sem valor são obrigatórias ou devem ser geradas por você.

# --- Banco de dados ---------------------------------------------------------
# No docker compose a API usa o host "db" automaticamente; DB_HOST vale para rodar fora do compose.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=predictspin
DB_USER=predictspin
DB_PASSWORD=
# Opcional: conexão inteira numa variável só (postgresql://usuario:senha@host:porta/banco), como o
# Render entrega. Se preenchida, vale no lugar de DB_HOST, DB_PORT, DB_NAME, DB_USER e DB_PASSWORD.
DATABASE_URL=
# Tamanho máximo do pool de conexões da API
DB_POOL_MAX=10

# --- API --------------------------------------------------------------------
# Porta HTTP da API (o Render injeta a própria)
PORT=8080
# Segredo do JWT (HS256): no mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
# Validade do token em milissegundos (86400000 = 24 h)
JWT_EXPIRATION_MS=86400000
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGENS=http://localhost:3000
# Limite de tentativas de login com falha, por e-mail e por IP, dentro da janela (segundos)
LOGIN_MAX_TENTATIVAS_EMAIL=5
LOGIN_MAX_TENTATIVAS_IP=20
LOGIN_JANELA_SEGUNDOS=900
# Opções da JVM (memória). Vazio usa o padrão do Dockerfile.
JAVA_OPTS=

# --- Carga inicial (só cria se ainda não existir) ---------------------------
ADMIN_NOME=Administrador
ADMIN_EMAIL=
# Mínimo de 8 caracteres
ADMIN_SENHA=

# --- Dispositivos (ESP32 e simulador) ---------------------------------------
# Sal concatenado à chave antes do hash SHA-256. Não troque depois de criar os dispositivos.
DEVICE_CREDENTIAL_SALT=
# Chave do dispositivo real ps-torno-01. Gere com: openssl rand -hex 32
DISPOSITIVO_TORNO_CHAVE=
# Chave do dispositivo simulado ps-sim-01 (usada também por analise/simulador.py e carga/telemetria.js)
DISPOSITIVO_SIM_CHAVE=

# --- Simulador e teste de carga ---------------------------------------------
# Endereço da API usado por analise/simulador.py (o k6 usa BASE_URL na linha de comando)
PREDICTSPIN_URL=http://localhost:8080

# --- Verificação de dependências (opcional) ---------------------------------
# Chave gratuita da base NVD; acelera `mvnw.cmd -P seguranca-dependencias verify`. Pode ficar vazia.
NVD_API_KEY=
